@startuml Edit_Class_Info
title Activity Diagram - Edit Class Information

|Admin|
start
:Select a class;
:Click "Edit Class";
:Update class details:\n- Class Name\n- Description\n- Instructor (optional);
:Click "Save";

|Web Application|
:Validate input data;
if (Valid?) then (no)
  :Display validation error;
  stop
endif

:Send updated class data\nto backend;

|Backend API|
:Validate request body;
:Call ClassService.\nUpdateClassAsync(classId, request);
:Get class by ID;
if (Class not found?) then (yes)
  :Return 404 Not Found;
  stop
endif

if (Class name updated?) then (yes)
  :Check if new name already\nexists in same semester;
  if (Class name exists?) then (yes)
    :Return 409 Conflict\n"Class name already exists";
    stop
  endif
  :Update ClassName;
endif

if (Description updated?) then (yes)
  :Update Description;
endif

if (Instructor updated?) then (yes)
  :Check if instructor exists;
  if (Instructor not found?) then (yes)
    :Return 400 Bad Request\n"Instructor not found";
    stop
  endif
  
  :Check if user has Instructor role;
  if (Invalid role?) then (yes)
    :Return 400 Bad Request\n"User must have Instructor role";
    stop
  endif
  :Update InstructorId;
endif

:Save changes to database;
:Return ClassResponseDto;
:Send 200 OK response;

|Web Application|
if (Response successful?) then (yes)
  :Display success message;
  :Refresh class list;
else (no)
  :Display error message;
  stop
endif

|Admin|
:View updated class information;
stop
@enduml



