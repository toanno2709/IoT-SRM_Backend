@startuml Edit_Milestone
title Activity Diagram - Edit Milestone

|Instructor|
start
:Select a milestone;
:Click "Edit Milestone";
:Update milestone details:\n- Title\n- Description\n- Due Date\n- Status\n- Weight (%);
:Click "Save";

|Web Application|
:Validate input data;
if (Valid?) then (no)
  :Display validation error;
  stop
endif

:Send updated milestone data\nto backend;

|Backend API|
:Validate request body;
:Call ProjectMilestoneService.\nUpdateAsync(request);
:Get milestone by ID;
if (Milestone not found?) then (yes)
  :Return 404 Not Found;
  stop
endif

if (Weight updated?) then (yes)
  :Check weight range (0-100);
  if (Weight invalid?) then (yes)
    :Return 400 Bad Request\n"Weight must be between 0 and 100";
    stop
  endif
  
  :Get current total weight\n(excluding this milestone);
  :Calculate new total weight\n= currentTotal + newWeight;
  if (Total weight > 100%?) then (yes)
    :Return 400 Bad Request\n"Total weight would be {total}, exceeds 100";
    stop
  endif
endif

:Update milestone entity:\n- Title\n- Description\n- DueDate\n- Status\n- Weight\n- UpdatedAt;
:Save changes to database;
:Return ProjectMilestoneResponseDto;
:Send 200 OK response;

|Web Application|
if (Response successful?) then (yes)
  :Display success message;
  :Refresh milestones list;
else (no)
  :Display error message;
  stop
endif

|Instructor|
:View updated milestone;
stop
@enduml

