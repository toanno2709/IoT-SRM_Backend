@startuml Assign_Instructor
hide footbox
skinparam participant {
  BackgroundColor white
  BorderColor black
}

skinparam actor {
  BackgroundColor white
}

title Sequence Diagram - Assign Instructor to Class

actor ":Admin" as Admin
participant ":Web Application" as Browser
participant ":ClassesController" as Controller
participant ":ClassService" as Service
participant ":Database" as DB

Admin -> Browser: 1. Select a class\nClick "Assign Instructor"
activate Browser

Browser --> Admin: 2. Display instructor selection form
deactivate Browser

Admin -> Browser: 3. Select an instructor\nfrom list\nClick "Assign"
activate Browser

Browser -> Browser: 4. Validate input data
alt Valid
    Browser -> Controller: 5. Send instructor assignment data\nto backend
    activate Controller
    
    Controller -> Service: 6. Call AssignInstructorAsync(classId, instructorId)
    activate Service
    
    Service -> DB: 7. Execute query:\nCheck if class exists
    activate DB
    DB --> Service: 8. Return result
    deactivate DB
    
    alt Class not found
        Service --> Controller: 9. Return 404 Not Found
    else Class found
        Service -> DB: 10. Execute query:\nCheck if instructor exists
        activate DB
        DB --> Service: 11. Return result
        deactivate DB
        
        alt Instructor not found
            Service --> Controller: 12. Return 400 Bad Request\n"Instructor not found"
        else Instructor found
            Service -> Service: 13. Check if user has Instructor role
            alt Invalid role
                Service --> Controller: 14. Return 400 Bad Request\n"User must have Instructor role"
            else Valid role
                Service -> DB: 15. Execute update:\nSet InstructorId = {instructorId}
                activate DB
                DB --> Service: 16. Return result
                deactivate DB
                
                Service --> Controller: 17. Return success message
            end
        end
    end
    deactivate Service
    
    Controller --> Browser: 18. Return response
    deactivate Controller
    
    alt Response successful
        Browser -> Browser: 19. Process response
        Browser --> Admin: 20. Display success message\nRefresh class details
    else Response failed
        Browser --> Admin: 20. Display error message
    end
else Invalid
    Browser --> Admin: 5. Display validation error
end
deactivate Browser

@enduml

