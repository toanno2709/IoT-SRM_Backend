@startuml Edit_Class_Info
hide footbox
skinparam participant {
  BackgroundColor white
  BorderColor black
}

skinparam actor {
  BackgroundColor white
}

title Sequence Diagram - Edit Class Information

actor ":Admin" as Admin
participant ":Web Application" as Browser
participant ":ClassesController" as Controller
participant ":ClassService" as Service
participant ":Database" as DB

Admin -> Browser: 1. Select a class\nClick "Edit Class"
activate Browser

Browser --> Admin: 2. Display edit class form
deactivate Browser

Admin -> Browser: 3. Update class details:\nClass Name, Description\nInstructor (optional)\nClick "Save"
activate Browser

Browser -> Browser: 4. Validate input data
alt Valid
    Browser -> Controller: 5. Send updated class data\nto backend
    activate Controller
    
    Controller -> Service: 6. Call UpdateClassAsync(classId, request)
    activate Service
    
    Service -> DB: 7. Execute query:\nGet class by ID
    activate DB
    DB --> Service: 8. Return result
    deactivate DB
    
    alt Class not found
        Service --> Controller: 9. Return 404 Not Found
    else Class found
        alt Class name updated
            Service -> DB: 10. Execute query:\nCheck if new name already\nexists in same semester
            activate DB
            DB --> Service: 11. Return result
            deactivate DB
            
            alt Class name exists
                Service --> Controller: 12. Return 409 Conflict\n"Class name already exists"
            else Class name available
                Service -> DB: 13. Execute update:\nUpdate ClassName
                activate DB
                DB --> Service: 14. Return result
                deactivate DB
            end
        end
        
        alt Description updated
            Service -> DB: 13. Execute update:\nUpdate Description
            activate DB
            DB --> Service: 14. Return result
            deactivate DB
        end
        
        alt Instructor updated
            Service -> DB: 15. Execute query:\nCheck if instructor exists
            activate DB
            DB --> Service: 16. Return result
            deactivate DB
            
            alt Instructor not found
                Service --> Controller: 17. Return 400 Bad Request\n"Instructor not found"
            else Instructor found
                Service -> Service: 18. Check if user has Instructor role
                alt Invalid role
                    Service --> Controller: 19. Return 400 Bad Request\n"User must have Instructor role"
                else Valid role
                    Service -> DB: 20. Execute update:\nUpdate InstructorId
                    activate DB
                    DB --> Service: 21. Return result
                    deactivate DB
                    
                    Service --> Controller: 22. Return ClassResponseDto
                end
            end
        else Instructor not updated
            Service --> Controller: 22. Return ClassResponseDto
        end
    end
    deactivate Service
    
    Controller --> Browser: 23. Return response
    deactivate Controller
    
    alt Response successful
        Browser -> Browser: 24. Process response
        Browser --> Admin: 25. Display success message\nRefresh class list
    else Response failed
        Browser --> Admin: 25. Display error message
    end
else Invalid
    Browser --> Admin: 5. Display validation error
end
deactivate Browser

@enduml

