@startuml Remove_Student_From_Group
hide footbox
skinparam participant {
  BackgroundColor white
  BorderColor black
}

skinparam actor {
  BackgroundColor white
}

title Sequence Diagram - Remove Student from Group

actor ":Instructor" as Instructor
participant ":Web Application" as Browser
participant ":InstructorController" as Controller
participant ":GroupManagementService" as Service
participant ":NotificationService" as NotifService
participant ":Database" as DB

Instructor -> Browser: 1. Select a group\nSelect a student member\nClick "Remove Member"
activate Browser

Browser -> Browser: 2. Confirm removal
Browser -> Controller: 3. Send request to remove member\nfrom group
activate Controller

Controller -> Service: 4. Call RemoveMemberAsync(groupId, userId)
activate Service

Service -> DB: 5. Execute query:\nCheck if group exists
activate DB
DB --> Service: 6. Return result
deactivate DB

alt Group not found
    Service --> Controller: 7. Return 404 Not Found
else Group found
    Service -> DB: 8. Execute query:\nCheck if member exists in group
    activate DB
    DB --> Service: 9. Return result
    deactivate DB
    
    alt Member not found
        Service --> Controller: 10. Return 404 Not Found
    else Member found
        Service -> DB: 11. Execute delete:\nRemove GroupMember entity
        activate DB
        DB --> Service: 12. Return result
        deactivate DB
        
        Service -> NotifService: 13. Send notification to removed student
        activate NotifService
        NotifService -> DB: 14. Create notification record
        activate DB
        DB --> NotifService: 15. Return result
        deactivate DB
        NotifService --> Service: 16. Return result
        deactivate NotifService
        
        Service --> Controller: 17. Return GroupMemberOperationResponseDto
    end
end
deactivate Service

Controller --> Browser: 18. Return response
deactivate Controller

alt Response successful
    Browser -> Browser: 19. Process response
    Browser --> Instructor: 20. Display success message\nRefresh group members list
else Response failed
    Browser --> Instructor: 20. Display error message
end
deactivate Browser

@enduml

