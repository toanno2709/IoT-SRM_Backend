@startuml Reset_Password
hide footbox
skinparam participant {
  BackgroundColor white
  BorderColor black
}

skinparam actor {
  BackgroundColor white
}

title Sequence Diagram - Reset User Password

actor ":Admin" as Admin
participant ":Web Application" as Browser
participant ":UserController" as Controller
participant ":UserService" as Service
participant ":UserHelper" as Helper
participant ":Database" as DB

Admin -> Browser: 1. Select a user\nClick "Reset Password"
activate Browser

Browser --> Admin: 2. Display reset password form
deactivate Browser

Admin -> Browser: 3. Enter new password\nConfirm new password\nClick "Reset"
activate Browser

Browser -> Browser: 4. Validate input data
alt Valid
    Browser -> Controller: 5. Send password reset data\nto backend
    activate Controller
    
    Controller -> Controller: 6. Extract admin ID\nfrom JWT token
    Controller -> Service: 7. Call UpdateUserAsync(userId, request, adminId, isAdmin)
    activate Service
    
    Service -> DB: 8. Execute query:\nCheck if user exists
    activate DB
    DB --> Service: 9. Return result
    deactivate DB
    
    alt User not found
        Service --> Controller: 10. Return 404 Not Found
    else User found
        Service -> Service: 11. Check authorization\n(Admin only)
        alt Unauthorized
            Service --> Controller: 12. Return 403 Forbidden
        else Authorized
            Service -> Helper: 13. Hash new password using BCrypt
            activate Helper
            Helper --> Service: 14. Return hashed password
            deactivate Helper
            
            Service -> DB: 15. Execute update:\nSet PasswordHash = {hashedPassword}
            activate DB
            DB --> Service: 16. Return result
            deactivate DB
            
            Service -> DB: 17. Execute query:\nGet updated user with role information
            activate DB
            DB --> Service: 18. Return result
            deactivate DB
            
            Service --> Controller: 19. Return UserResponseDto
        end
    end
    deactivate Service
    
    Controller --> Browser: 20. Return response
    deactivate Controller
    
    alt Response successful
        Browser -> Browser: 21. Process response
        Browser --> Admin: 22. Display success message\n"Password reset successfully"\nRefresh user list
    else Response failed
        Browser --> Admin: 22. Display error message
    end
else Invalid
    Browser --> Admin: 5. Display validation error
end
deactivate Browser

@enduml

