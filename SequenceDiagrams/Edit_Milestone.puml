@startuml Edit_Milestone
hide footbox
skinparam participant {
  BackgroundColor white
  BorderColor black
}

skinparam actor {
  BackgroundColor white
}

title Sequence Diagram - Edit Milestone

actor ":Instructor" as Instructor
participant ":Web Application" as Browser
participant ":ProjectMilestonesController" as Controller
participant ":ProjectMilestoneService" as Service
participant ":Database" as DB

Instructor -> Browser: 1. Select a milestone\nClick "Edit Milestone"
activate Browser

Browser --> Instructor: 2. Display edit milestone form
deactivate Browser

Instructor -> Browser: 3. Update milestone details:\nTitle, Description, Due Date, Status, Weight\nClick "Save"
activate Browser

Browser -> Browser: 4. Validate input data
alt Valid
    Browser -> Controller: 5. Send updated milestone data\nto backend
    activate Controller
    
    Controller -> Service: 6. Call UpdateAsync(request)
    activate Service
    
    Service -> DB: 7. Execute query:\nGet milestone by ID
    activate DB
    DB --> Service: 8. Return result
    deactivate DB
    
    alt Milestone not found
        Service --> Controller: 9. Return 404 Not Found
    else Milestone found
        alt Weight updated
            Service -> Service: 10. Check weight range (0-100)
            alt Weight invalid
                Service --> Controller: 11. Return 400 Bad Request\n"Weight must be between 0 and 100"
            else Weight valid
                Service -> DB: 12. Execute query:\nGet current total weight\n(excluding this milestone)
                activate DB
                DB --> Service: 13. Return result
                deactivate DB
                
                Service -> Service: 14. Calculate new total weight\n= currentTotal + newWeight
                alt Total weight > 100%
                    Service --> Controller: 15. Return 400 Bad Request\n"Total weight would exceed 100"
                else Total weight valid
                    Service -> DB: 16. Execute update:\nTitle, Description, DueDate, Status, Weight, UpdatedAt
                    activate DB
                    DB --> Service: 17. Return result
                    deactivate DB
                    
                    Service --> Controller: 18. Return ProjectMilestoneResponseDto
                end
            end
        else Weight not updated
            Service -> DB: 16. Execute update:\nTitle, Description, DueDate, Status, UpdatedAt
            activate DB
            DB --> Service: 17. Return result
            deactivate DB
            
            Service --> Controller: 18. Return ProjectMilestoneResponseDto
        end
    end
    deactivate Service
    
    Controller --> Browser: 19. Return response
    deactivate Controller
    
    alt Response successful
        Browser -> Browser: 20. Process response
        Browser --> Instructor: 21. Display success message\nRefresh milestones list
    else Response failed
        Browser --> Instructor: 21. Display error message
    end
else Invalid
    Browser --> Instructor: 5. Display validation error
end
deactivate Browser

@enduml

