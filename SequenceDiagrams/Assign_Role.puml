@startuml Assign_Role
hide footbox
skinparam participant {
  BackgroundColor white
  BorderColor black
}

skinparam actor {
  BackgroundColor white
}

title Sequence Diagram - Assign Role to User

actor ":Admin" as Admin
participant ":Web Application" as Browser
participant ":UserController" as Controller
participant ":UserService" as Service
participant ":Database" as DB

Admin -> Browser: 1. Select a user\nClick "Edit User"
activate Browser

Browser --> Admin: 2. Display edit user form
deactivate Browser

Admin -> Browser: 3. Select new role\nClick "Save"
activate Browser

Browser -> Browser: 4. Validate input data
alt Valid
    Browser -> Controller: 5. Send updated user data\nto backend
    activate Controller
    
    Controller -> Controller: 6. Extract admin ID\nfrom JWT token
    Controller -> Service: 7. Call UpdateUserAsync(userId, request, adminId, isAdmin)
    activate Service
    
    Service -> DB: 8. Execute query:\nCheck if user exists
    activate DB
    DB --> Service: 9. Return result
    deactivate DB
    
    alt User not found
        Service --> Controller: 10. Return 404 Not Found
    else User found
        Service -> Service: 11. Check authorization\n(Admin or user themselves)
        alt Unauthorized
            Service --> Controller: 12. Return 403 Forbidden
        else Authorized
            Service -> DB: 13. Execute update:\nSet RoleId = {newRoleId}
            activate DB
            DB --> Service: 14. Return result
            deactivate DB
            
            Service -> DB: 15. Execute query:\nGet updated user with role information
            activate DB
            DB --> Service: 16. Return result
            deactivate DB
            
            Service --> Controller: 17. Return UserResponseDto
        end
    end
    deactivate Service
    
    Controller --> Browser: 18. Return response
    deactivate Controller
    
    alt Response successful
        Browser -> Browser: 19. Process response
        Browser --> Admin: 20. Display success message\nRefresh user list
    else Response failed
        Browser --> Admin: 20. Display error message
    end
else Invalid
    Browser --> Admin: 5. Display validation error
end
deactivate Browser

@enduml

