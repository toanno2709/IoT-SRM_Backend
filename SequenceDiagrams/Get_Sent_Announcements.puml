@startuml Get_Sent_Announcements
hide footbox
skinparam participant {
  BackgroundColor white
  BorderColor black
}

skinparam actor {
  BackgroundColor white
}

title Sequence Diagram - Get Sent Announcements

actor ":Instructor" as Instructor
participant ":Web Application" as Browser
participant ":InstructorController" as Controller
participant ":AnnouncementService" as Service
participant ":Database" as DB

Instructor -> Browser: 1. Open Announcements page\nClick "My Announcements"
activate Browser

Browser -> Controller: 2. Send request to retrieve\nsent announcements
activate Controller

Controller -> Controller: 3. Extract admin/instructor ID\nfrom JWT token
Controller -> Service: 4. Call GetAnnouncementsByAdminAsync(adminUserId)
activate Service

Service -> DB: 5. Execute query:\nGet announcements where\nadminId = {adminUserId}\nInclude related data\nOrder by CreatedAt DESC
activate DB
DB --> Service: 6. Return result
deactivate DB

alt Announcements found
    Service -> Service: 7. Map to AnnouncementResponseDto
    Service --> Controller: 8. Return List<AnnouncementResponseDto>
else No announcements found
    Service --> Controller: 8. Return empty list
end
deactivate Service

Controller --> Browser: 9. Return 200 OK response
deactivate Controller

alt Response successful
    Browser -> Browser: 10. Process response data
    Browser --> Instructor: 11. Display announcements list\nwith title, content\ntarget audience, and date
else Response failed
    Browser --> Instructor: 11. Display error message
end
deactivate Browser

@enduml

