@startuml Send_Announcement
hide footbox
skinparam participant {
  BackgroundColor white
  BorderColor black
}

skinparam actor {
  BackgroundColor white
}

title Sequence Diagram - Send Announcement

actor ":Instructor" as Instructor
participant ":Web Application" as Browser
participant ":InstructorController" as Controller
participant ":AnnouncementService" as Service
participant ":NotificationService" as NotifService
participant ":Database" as DB

Instructor -> Browser: 1. Open Announcements page\nClick "Create Announcement"
activate Browser

Browser --> Instructor: 2. Display create announcement form
deactivate Browser

Instructor -> Browser: 3. Enter announcement details:\nTitle, Content, Target Audience\n(All/Class/Specific)
activate Browser

alt Target Audience == "Class"
    Instructor -> Browser: 4. Select class
else Target Audience == "Specific"
    Instructor -> Browser: 4. Select students
end

Instructor -> Browser: 5. Click "Send"
Browser -> Browser: 6. Validate input data
alt Valid
    Browser -> Controller: 7. Send announcement data\nto backend
    activate Controller
    
    Controller -> Controller: 8. Extract admin/instructor ID\nfrom JWT token
    Controller -> Service: 9. Call CreateAnnouncementAsync(adminUserId, request)
    activate Service
    
    Service -> DB: 10. Execute insert:\nCreate Announcement entity\nAdminId, Title, Content\nTargetAudience, CreatedAt
    activate DB
    DB --> Service: 11. Return result
    deactivate DB
    
    alt Target Audience == "Class"
        Service -> DB: 12. Execute query:\nGet all students in class
        activate DB
        DB --> Service: 13. Return result
        deactivate DB
        Service -> NotifService: 14. Send bulk notifications\nto all students
    else Target Audience == "All"
        Service -> DB: 12. Execute query:\nGet all students
        activate DB
        DB --> Service: 13. Return result
        deactivate DB
        Service -> NotifService: 14. Send bulk notifications
    else Target Audience == "Specific"
        Service -> NotifService: 14. Send notifications\nto selected students
    end
    activate NotifService
    NotifService -> DB: 15. Create notification records
    activate DB
    DB --> NotifService: 16. Return result
    deactivate DB
    NotifService --> Service: 17. Return result
    deactivate NotifService
    
    Service --> Controller: 18. Return AnnouncementResponseDto
    deactivate Service
    
    Controller --> Browser: 19. Return response
    deactivate Controller
    
    alt Response successful
        Browser -> Browser: 20. Process response
        Browser --> Instructor: 21. Display success message\nRefresh announcements list
    else Response failed
        Browser --> Instructor: 21. Display error message
    end
else Invalid
    Browser --> Instructor: 7. Display validation error
end
deactivate Browser

@enduml

