@startuml Edit_Group_Info
hide footbox
skinparam participant {
  BackgroundColor white
  BorderColor black
}

skinparam actor {
  BackgroundColor white
}

title Sequence Diagram - Edit Group Info

actor ":Instructor" as Instructor
participant ":Web Application" as Browser
participant ":InstructorController" as Controller
participant ":GroupManagementService" as Service
participant ":Database" as DB

Instructor -> Browser: 1. Select a group and\nclick "Edit Group"
activate Browser

Browser --> Instructor: 2. Display edit form
deactivate Browser

Instructor -> Browser: 3. Input new group name\nand description\nClick "Save"
activate Browser

Browser -> Browser: 4. Validate input data
alt Valid
    Browser -> Controller: 5. Send updated group info\nto backend
    activate Controller
    
    Controller -> Service: 6. Call UpdateGroupInfoAsync(groupId, request)
    activate Service
    
    Service -> DB: 7. Execute query:\nCheck if group exists
    activate DB
    DB --> Service: 8. Return result
    deactivate DB
    
    alt Group found
        Service -> DB: 9. Execute update:\nGroupName, Description, UpdatedAt
        activate DB
        DB --> Service: 10. Return result
        deactivate DB
        
        alt Update successful
            Service --> Controller: 11. Return GroupResponseDto
        else Update failed
            Service --> Controller: 11. Return error message
        end
    else Group not found
        Service --> Controller: 11. Return 404 Not Found
    end
    deactivate Service
    
    Controller --> Browser: 12. Return response
    deactivate Controller
    
    alt Response successful
        Browser -> Browser: 13. Process response
        Browser --> Instructor: 14. Display success message\nRefresh group list
    else Response failed
        Browser --> Instructor: 14. Display error message
    end
else Invalid
    Browser --> Instructor: 5. Display validation error
end
deactivate Browser

@enduml

