@startuml Create_Milestone
hide footbox
skinparam participant {
  BackgroundColor white
  BorderColor black
}

skinparam actor {
  BackgroundColor white
}

title Sequence Diagram - Create Milestone

actor ":Instructor" as Instructor
participant ":Web Application" as Browser
participant ":ProjectMilestonesController" as Controller
participant ":ProjectMilestoneService" as Service
participant ":Database" as DB

Instructor -> Browser: 1. Select a project\nClick "Create Milestone"
activate Browser

Browser --> Instructor: 2. Display create milestone form
deactivate Browser

Instructor -> Browser: 3. Enter milestone details:\nTitle, Description, Due Date, Weight\nClick "Create"
activate Browser

Browser -> Browser: 4. Validate input data
alt Valid
    Browser -> Controller: 5. Send request to create\nnew milestone
    activate Controller
    
    Controller -> Service: 6. Call CreateAsync(request)
    activate Service
    
    Service -> Service: 7. Check if title is provided
    alt Title empty
        Service --> Controller: 8. Return 400 Bad Request\n"Title is required"
    else Title provided
        Service -> Service: 9. Check weight range (0-100)
        alt Weight invalid
            Service --> Controller: 10. Return 400 Bad Request\n"Weight must be between 0 and 100"
        else Weight valid
            Service -> DB: 11. Execute query:\nGet current total weight\nof all milestones in project
            activate DB
            DB --> Service: 12. Return result
            deactivate DB
            
            Service -> Service: 13. Calculate new total weight\n= currentTotal + newWeight
            
            alt Total weight > 100%
                Service --> Controller: 14. Return 400 Bad Request\n"Total weight would exceed 100"
            else Total weight valid
                Service -> DB: 15. Execute insert:\nCreate ProjectMilestone entity\nProjectId, Title, Description, DueDate\nStatus = "Planned", Weight, CreatedAt
                activate DB
                DB --> Service: 16. Return result
                deactivate DB
                
                Service --> Controller: 17. Return ProjectMilestoneResponseDto
            end
        end
    end
    deactivate Service
    
    Controller --> Browser: 18. Return response
    deactivate Controller
    
    alt Response successful
        Browser -> Browser: 19. Process response
        Browser --> Instructor: 20. Display success message\nRefresh milestones list
    else Response failed
        Browser --> Instructor: 20. Display error message
    end
else Invalid
    Browser --> Instructor: 5. Display validation error
end
deactivate Browser

@enduml

