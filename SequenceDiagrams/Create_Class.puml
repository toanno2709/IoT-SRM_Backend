@startuml Create_Class
hide footbox
skinparam participant {
  BackgroundColor white
  BorderColor black
}

skinparam actor {
  BackgroundColor white
}

title Sequence Diagram - Create Class

actor ":Admin" as Admin
participant ":Web Application" as Browser
participant ":ClassesController" as Controller
participant ":ClassService" as Service
participant ":Database" as DB

Admin -> Browser: 1. Open Admin Dashboard\nClick "Class Management"\nClick "Create New Class"
activate Browser

Browser --> Admin: 2. Display create class form
deactivate Browser

Admin -> Browser: 3. Enter class details:\nClass Name, Semester\nDescription, Instructor (optional)\nClick "Create"
activate Browser

Browser -> Browser: 4. Validate input data
alt Valid
    Browser -> Controller: 5. Send class creation data\nto backend
    activate Controller
    
    Controller -> Service: 6. Call CreateClassAsync(request)
    activate Service
    
    Service -> DB: 7. Execute query:\nCheck if semester exists
    activate DB
    DB --> Service: 8. Return result
    deactivate DB
    
    alt Semester not found
        Service --> Controller: 9. Return 400 Bad Request\n"Semester not found"
    else Semester found
        Service -> DB: 10. Execute query:\nCheck if class name already\nexists in this semester
        activate DB
        DB --> Service: 11. Return result
        deactivate DB
        
        alt Class name exists
            Service --> Controller: 12. Return 409 Conflict\n"Class already exists in this semester"
        else Class name available
            alt Instructor provided
                Service -> DB: 13. Execute query:\nCheck if instructor exists
                activate DB
                DB --> Service: 14. Return result
                deactivate DB
                
                alt Instructor not found
                    Service --> Controller: 15. Return 400 Bad Request\n"Instructor not found"
                else Instructor found
                    Service -> Service: 16. Check if user has Instructor role
                    alt Invalid role
                        Service --> Controller: 17. Return 400 Bad Request\n"User must have Instructor role"
                    else Valid role
                        Service -> DB: 18. Execute insert:\nCreate new Class entity\nClassName, SemesterId\nDescription, InstructorId, CreatedAt
                        activate DB
                        DB --> Service: 19. Return result
                        deactivate DB
                        
                        Service --> Controller: 20. Return ClassResponseDto
                    end
                end
            else Instructor not provided
                Service -> DB: 18. Execute insert:\nCreate new Class entity\nClassName, SemesterId\nDescription, CreatedAt
                activate DB
                DB --> Service: 19. Return result
                deactivate DB
                
                Service --> Controller: 20. Return ClassResponseDto
            end
        end
    end
    deactivate Service
    
    Controller --> Browser: 21. Return response
    deactivate Controller
    
    alt Response successful
        Browser -> Browser: 22. Process response
        Browser --> Admin: 23. Display success message\nRefresh class list
    else Response failed
        Browser --> Admin: 23. Display error message
    end
else Invalid
    Browser --> Admin: 5. Display validation error
end
deactivate Browser

@enduml

