@startuml View_Pending_Topic_Proposals
hide footbox
skinparam participant {
  BackgroundColor white
  BorderColor black
}

skinparam actor {
  BackgroundColor white
}

title Sequence Diagram - View Pending Topic Proposals

actor ":Instructor" as Instructor
participant ":Web Application" as Browser
participant ":InstructorController" as Controller
participant ":TopicProposalService" as Service
participant ":Database" as DB

Instructor -> Browser: 1. Open Instructor Dashboard\nClick "Pending Proposals"
activate Browser

Browser -> Controller: 2. Send request to retrieve\npending topic proposals
activate Controller

Controller -> Controller: 3. Extract instructorId\nfrom JWT token
Controller -> Service: 4. Call GetPendingProposalsAsync(instructorId)
activate Service

Service -> DB: 5. Execute query:\nGet MilestoneSubmissions\nWhere class instructorId = {instructorId}\nWhere milestone title contains "Proposal"\nWhere no approval history\nInclude related data
activate DB
DB --> Service: 6. Return result
deactivate DB

alt Proposals found
    Service -> Service: 7. Map to TopicProposalResponseDto
    Service --> Controller: 8. Return List<TopicProposalResponseDto>
else No proposals found
    Service --> Controller: 8. Return empty list
end
deactivate Service

Controller --> Browser: 9. Return 200 OK response
deactivate Controller

alt Response successful
    Browser -> Browser: 10. Process response data
    Browser --> Instructor: 11. Display pending proposals list\nwith project details and files
else Response failed
    Browser --> Instructor: 11. Display error message
end
deactivate Browser

@enduml

