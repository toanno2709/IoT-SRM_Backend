@startuml View_All_Groups_Projects
hide footbox
skinparam participant {
  BackgroundColor white
  BorderColor black
}

skinparam actor {
  BackgroundColor white
}

title Sequence Diagram - View All Groups and Projects

actor ":Admin" as Admin
participant ":Web Application" as Browser
participant ":AdminController" as Controller
participant ":GroupService" as GroupService
participant ":ProjectService" as ProjectService
participant ":Database" as DB

Admin -> Browser: 1. Open Admin Dashboard\nClick "Monitor Projects"
activate Browser

Browser -> Controller: 2. Send request to retrieve\nall groups and projects
activate Controller

Controller -> GroupService: 3. Call GetAllGroupsAsync()
activate GroupService
GroupService -> DB: 4. Execute query:\nGet all groups\nInclude related data
activate DB
DB --> GroupService: 5. Return result
deactivate DB
GroupService --> Controller: 6. Return groups list
deactivate GroupService

Controller -> ProjectService: 7. Call GetAllProjectsAsync()
activate ProjectService
ProjectService -> DB: 8. Execute query:\nGet all projects\nInclude related data
activate DB
DB --> ProjectService: 9. Return result
deactivate DB
ProjectService --> Controller: 10. Return projects list
deactivate ProjectService

Controller -> Controller: 11. Map entities to DTOs\nCombine groups and projects data
Controller --> Browser: 12. Return 200 OK response\nwith groups and projects
deactivate Controller

alt Response successful
    Browser -> Browser: 13. Process response data
    Browser --> Admin: 14. Display groups and projects list\nwith details\n(Group name, Members, Projects, Status)
else Response failed
    Browser --> Admin: 14. Display error message
end
deactivate Browser

@enduml

