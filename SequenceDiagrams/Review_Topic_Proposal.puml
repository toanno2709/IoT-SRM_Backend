@startuml Review_Topic_Proposal
hide footbox
skinparam participant {
  BackgroundColor white
  BorderColor black
}

skinparam actor {
  BackgroundColor white
}

title Sequence Diagram - Review Topic Proposal (Approve/Reject/Request Revision)

actor ":Instructor" as Instructor
participant ":Web Application" as Browser
participant ":InstructorController" as Controller
participant ":TopicProposalService" as Service
participant ":Database" as DB

Instructor -> Browser: 1. View pending proposal details\nReview project documents
activate Browser

Browser --> Instructor: 2. Display proposal details form
deactivate Browser

Instructor -> Browser: 3. Select decision:\nApprove/Reject/Request Revision\nEnter review comment\nClick "Submit Review"
activate Browser

Browser -> Browser: 4. Validate request body
alt Valid
    Browser -> Controller: 5. Send review decision\nto backend
    activate Controller
    
    Controller -> Controller: 6. Extract instructorId\nfrom JWT token
    Controller -> Service: 7. Call ReviewProposalAsync(instructorId, submissionId, request)
    activate Service
    
    Service -> DB: 8. Execute query:\nGet submission with details
    activate DB
    DB --> Service: 9. Return result
    deactivate DB
    
    alt Submission not found
        Service --> Controller: 10. Return 404 Not Found
    else Submission found
        Service -> Service: 11. Check if instructor owns class
        alt Unauthorized
            Service --> Controller: 12. Return 403 Forbidden
        else Authorized
            Service -> DB: 13. Execute insert:\nCreate ProjectApprovalHistory record\nAction, Comment, ActedAt
            activate DB
            DB --> Service: 14. Return result
            deactivate DB
            
            alt ReviewStatus == "Approved"
                Service -> DB: 15. Execute update:\nUpdate Project status to "Approved"
                activate DB
                DB --> Service: 16. Return result
                deactivate DB
            end
            
            Service --> Controller: 17. Return TopicProposalReviewResponseDto
        end
    end
    deactivate Service
    
    Controller --> Browser: 18. Return response
    deactivate Controller
    
    alt Response successful
        Browser -> Browser: 19. Process response
        Browser --> Instructor: 20. Display success message\nRemove proposal from pending list\nSend notification to student group
    else Response failed
        Browser --> Instructor: 20. Display error message
    end
else Invalid
    Browser --> Instructor: 5. Display validation error
end
deactivate Browser

@enduml

