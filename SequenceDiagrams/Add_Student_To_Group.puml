@startuml Add_Student_To_Group
hide footbox
skinparam participant {
  BackgroundColor white
  BorderColor black
}

skinparam actor {
  BackgroundColor white
}

title Sequence Diagram - Add Student to Group

actor ":Instructor" as Instructor
participant ":Web Application" as Browser
participant ":InstructorController" as Controller
participant ":GroupManagementService" as Service
participant ":NotificationService" as NotifService
participant ":Database" as DB

Instructor -> Browser: 1. Select a group and\nclick "Add Member"
activate Browser

Browser --> Instructor: 2. Display add member form
deactivate Browser

Instructor -> Browser: 3. Enter student ID or email\nSelect role (optional)\nClick "Add"
activate Browser

Browser -> Browser: 4. Validate input data
alt Valid
    Browser -> Controller: 5. Send request to add member\nto group
    activate Controller
    
    Controller -> Service: 6. Call AddMemberAsync(groupId, request)
    activate Service
    
    Service -> DB: 7. Execute query:\nCheck if group exists
    activate DB
    DB --> Service: 8. Return result
    deactivate DB
    
    alt Group not found
        Service --> Controller: 9. Return 404 Not Found
    else Group found
        Service -> DB: 10. Execute query:\nCheck if student exists
        activate DB
        DB --> Service: 11. Return result
        deactivate DB
        
        alt Student not found
            Service --> Controller: 12. Return 404 Not Found
        else Student found
            Service -> DB: 13. Execute query:\nCheck if student already\nin another group in same class
            activate DB
            DB --> Service: 14. Return result
            deactivate DB
            
            alt Already in group
                Service --> Controller: 15. Return 400 Bad Request\n"Student already in group"
            else Not in group
                Service -> DB: 16. Execute insert:\nCreate GroupMember entity
                activate DB
                DB --> Service: 17. Return result
                deactivate DB
                
                Service -> NotifService: 18. Send notification to student
                activate NotifService
                NotifService -> DB: 19. Create notification record
                activate DB
                DB --> NotifService: 20. Return result
                deactivate DB
                NotifService --> Service: 21. Return result
                deactivate NotifService
                
                Service --> Controller: 22. Return GroupMemberOperationResponseDto
            end
        end
    end
    deactivate Service
    
    Controller --> Browser: 23. Return response
    deactivate Controller
    
    alt Response successful
        Browser -> Browser: 24. Process response
        Browser --> Instructor: 25. Display success message\nRefresh group members list
    else Response failed
        Browser --> Instructor: 25. Display error message
    end
else Invalid
    Browser --> Instructor: 5. Display validation error
end
deactivate Browser

@enduml

