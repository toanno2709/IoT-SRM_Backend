@startuml View_Groups_In_Class
hide footbox
skinparam participant {
  BackgroundColor white
  BorderColor black
}

skinparam actor {
  BackgroundColor white
}

title Sequence Diagram - View All Groups in Class

actor ":Instructor" as Instructor
participant ":Web Application" as Browser
participant ":InstructorController" as Controller
participant ":GroupService" as Service
participant ":Database" as DB

Instructor -> Browser: 1. Select a class and\nclick "View Groups"
activate Browser

Browser -> Controller: 2. Send request to retrieve\ngroups in class
activate Controller

Controller -> Service: 3. Call GetGroupsByClassAsync(classId)
activate Service

Service -> DB: 4. Execute query:\nGet groups where\nclassId = {classId}\nInclude related data
activate DB
DB --> Service: 5. Return result
deactivate DB

alt Groups found
    Service -> Service: 6. Map entities to GroupResponseDto
    Service --> Controller: 7. Return List<GroupResponseDto>
else No groups found
    Service --> Controller: 7. Return empty list
end
deactivate Service

Controller --> Browser: 8. Return 200 OK response
deactivate Controller

alt Response successful
    Browser -> Browser: 9. Process response data
    Browser --> Instructor: 10. Display groups list\nwith members and projects
else Response failed
    Browser --> Instructor: 10. Display error message
end
deactivate Browser

@enduml

