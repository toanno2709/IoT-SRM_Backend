@startuml Get_Assigned_Classes
hide footbox
skinparam participant {
  BackgroundColor white
  BorderColor black
}

skinparam actor {
  BackgroundColor white
}

title Sequence Diagram - Get Assigned Classes

actor ":Instructor" as Instructor
participant ":Web Application" as Browser
participant ":InstructorController" as Controller
participant ":ClassService" as Service
participant ":Database" as DB

Instructor -> Browser: 1. Click "View My Classes"
activate Browser

Browser -> Controller: 2. Send request to retrieve\nassigned classes
activate Controller

Controller -> Service: 3. Call GetAssignedClassesAsync(instructorId)
activate Service

Service -> DB: 4. Execute query:\nGet classes where\ninstructorId = {id}\nInclude related data
activate DB
DB --> Service: 5. Return result
deactivate DB

alt Classes found
    Service -> Service: 6. Map entities to DTOs\n(ClassResponseDto)
    Service --> Controller: 7. Return List<ClassResponseDto>
else No classes found
    Service --> Controller: 7. Return empty list
end
deactivate Service

Controller --> Browser: 8. Return 200 OK response
deactivate Controller

alt Response successful
    Browser -> Browser: 9. Process response data
    Browser --> Instructor: 10. Display list of classes\nwith details\n(ClassName, Semester, TotalStudents, TotalGroups)
else Response failed
    Browser --> Instructor: 10. Display error message
end
deactivate Browser

@enduml

